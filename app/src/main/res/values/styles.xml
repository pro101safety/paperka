<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Кастомный стиль для заголовка Toolbar -->
    <style name="CustomToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <style name="DrawerMenuItemText" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="DrawerHeaderTitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/drawer_text_primary</item>
    </style>

    <style name="DrawerHeaderSubtitleText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/drawer_text_secondary</item>
    </style>
</resources>
