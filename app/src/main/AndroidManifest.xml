<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papera"
        tools:targetApi="36">

        <activity
            android:name=".Contact"
            android:exported="false" />

        <activity
            android:name=".Privacy"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"/>

        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity
            android:name=".LuxometerActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".NoiseMeterActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".ThermometerActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".CompassActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".LevelActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".VibrometerActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".FullView"
            android:exported="false" />
        <activity
            android:name=".game.IotGameActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:theme="@style/Theme.Papera" />
        <activity
            android:name=".SplashScreen"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>